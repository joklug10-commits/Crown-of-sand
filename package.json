{
  "name": "crown-of-sand",
  "version": "1.0.0",
  "private": true,
  "description": "Crown of Sand: Build. Defend. Conquer. – Burgen-Strategiespiel (Web-App und iOS-App)",
  "scripts": {
    "build:site": "python3 tools/build_site.py",
    "build:www": "node tools/build_www.mjs",
    "ios:sync": "npm run build:www && npx cap sync ios",
    "ios:assets": "npx @capacitor/assets generate --ios --iconBackgroundColor '#120d08' --splashBackgroundColor '#120d08'"
  },
  "dependencies": {
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@capacitor/splash-screen": "8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@capacitor/assets": "4.0.0"
  }
}
